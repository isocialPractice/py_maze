# Byte-compiled and cached bytecode
__pycache__/
*.py[cod]
*$py.class

# Packaging and build output
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
env/

# Local scratch space
.tmp/

# GitHub's own folder, which the global ignore file's dot-file rule would
# otherwise keep out of the repository along with everything under it
!.github/

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
